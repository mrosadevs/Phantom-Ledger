{
  "name": "accuracy-phantom-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "Accuracy Phantom Ledger: bank statement PDF extraction + transaction cleaning in one flow.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test server/pdfParser.test.js",
    "start": "cross-env NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@accuracy/statement-parser": "github:mrosadevs/phantom-statement-parser#v1.1.1",
    "canvas": "^3.2.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9",
    "vite": "^6.2.0"
  }
}
